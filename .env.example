# PQC Management API – environment configuration
#
# Reference only. The application reads its configuration from the process
# environment and does not load a .env file, so set these in your orchestrator:
# the gateway's docker-compose.yml supplies them, via `environment:` for plain
# values and Docker secrets for the sensitive ones. Defaults are the MOST
# RESTRICTIVE (deny).

# ── JWT verification (gateway-minted RS256) ──────────────────────────────────
GATEWAY_JWKS_URI=https://gateway:8081/.well-known/jwks.json
JWT_EXPECTED_ISSUER=pqc-gateway
JWT_EXPECTED_AUDIENCE=pqc-mtls-management-api

# ── Authorization: certificate fingerprint → role (RBAC) ─────────────────────
# SHA-256 cert fingerprints (64 lowercase hex chars, no colons), comma/space/
# newline separated. Resolve the caller's role from the fpr – NEVER a JWT claim.
#   ADMIN  → read + write (all routes)
#   AUDITOR→ read-only (GET routes); blocked on POST/PUT/DELETE/PATCH
# A fpr in neither list is denied (fail-closed). Empty admin list = deny all.
# The `_FILE` variants point at a mounted secret and take precedence.
ADMIN_CERT_FINGERPRINTS=
# ADMIN_CERT_FINGERPRINTS_FILE=/run/secrets/admin-cert-fingerprints
AUDITOR_CERT_FINGERPRINTS=
# AUDITOR_CERT_FINGERPRINTS_FILE=/run/secrets/auditor-cert-fingerprints

# ── Anti-CSRF (browser console protection) ───────────────────────────────────
# Allowed Origin(s) for state-changing requests on JWT-protected routes.
# Defaults to CORS_ALLOWED_ORIGINS when unset. Every such request must carry a
# non-empty `X-PQC-CSRF` header; an Origin, when the client sends one, must also
# be in this allowlist. @Public() routes (e.g. POST /admin/certs/sign) are exempt.
CONSOLE_ORIGIN=
CORS_ALLOWED_ORIGINS=

# ── Admin-action audit trail (control-plane mutations) ───────────────────────
# Tamper-evident NDJSON hash chain. MUST be on the writable app volume
# (/var/lib/pqc-mgmt) – never the read-only /var/log/pqc-gw or CA tree.
ADMIN_AUDIT_LOG=/var/lib/pqc-mgmt/admin-actions.log

# ── Gateway control plane (policy push) ──────────────────────────────────────
GATEWAY_CONTROL_URL=https://gateway:8081/update-routes
# GATEWAY_HMAC_SECRET=   # prefer the /run/secrets/control-plane-hmac file

# ── Enrollment token store ───────────────────────────────────────────────────
# Required in production (durable, cross-instance single-use guarantee).
# REDIS_URL=redis://redis:6379

# ── PKI paths / OpenSSL (defaults match the container layout) ────────────────
# OPENSSL_BIN=/opt/openssl-3.6.2/bin/openssl
# OPENSSL_CONF=/etc/pki/pqc-ca/openssl.cnf
#   Not read by this service. It is inherited by the openssl child process
#   the certificate reader spawns, and PQ certificate parsing fails without it.
# ROUTES_FILE=/var/lib/pqc-mgmt/routes.json
# AUDIT_LOG_PATH=/var/log/pqc-gw/enroll-audit.log

# -- Read by the code, previously undocumented --------------------------------
# Custodian: the only component with CA private-key access. All signing,
# revocation and CA-index reads go through it.
CUSTODIAN_URL=http://pqc-ca-custodian:8091

# HMAC secrets are read from /run/secrets/<name> FIRST; these env vars are only
# the fallback for running outside Docker. Compose mounts the files, so leave
# both unset there rather than copying a live secret into the environment.
# CUSTODIAN_HMAC_SECRET=
# ENROLL_HMAC_SECRET=

# Second JWT audience, for the cert-lookup token. Distinct from the admin
# audience above so a lookup token cannot be replayed against the admin API.
# JWT_EXPECTED_LOOKUP_AUDIENCE=

# CRL renewal: the signal file the API touches to ask the renewer to run, and
# the script the renewer executes.
CRL_RENEW_SIGNAL_FILE=/signals/renew-crl
# CRL_RENEW_SCRIPT=/usr/local/bin/pqc-crl-renew.sh

# Listener. NODE_ENV=production additionally makes the API refuse to start with
# an in-memory policy store, so Redis becomes mandatory.
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
